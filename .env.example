# Copy to .env and fill in. Never commit the real .env.
# Every variable the bot reads is listed here; anything not listed is not read.
# A malformed value stops the boot with a line naming the variable (see bot/config.py).

# From @BotFather (/newbot). Required.
BOT_TOKEN=123456789:AA-your-botfather-token

# Base URL of the Tracker Spring Boot API (the bot calls it directly — no browser/CORS).
# Must include the scheme. In compose, use the service name: http://backend:8080/api/v1
API_BASE_URL=http://localhost:8080/api/v1

# Seconds to wait on one API call before giving up.
API_TIMEOUT=10

# A login lasts until /lock: the bot refreshes its tokens before they run out. With this on, the
# owner's login, language, last wallet and category guesses are kept across restarts in
# SESSION_FILE (with OWNER_CHAT_ID, or else the chat that logged in first — also saved there).
# The file holds a refresh token; it is chmod 600 and /lock deletes the login from it.
STAY_LOGGED_IN=true
SESSION_FILE=data/session.json

# --- Who the bot answers to ---
# Tracker is single-user. Set this to your own numeric chat id (@userinfobot will tell you)
# and the bot refuses every other chat outright. Leave it blank and the FIRST chat that logs
# in successfully claims the bot (the claim is saved in SESSION_FILE) — the id it bound is
# logged at INFO, so start the bot, log in, then copy that id in here and restart.
OWNER_CHAT_ID=

# --- Time ---
# Hours ahead of UTC the owner lives in; Tashkent is +5 and Uzbekistan has no DST. This is
# what "today" and "this month" mean to the bot — the container's own clock is not consulted,
# so a UTC container cannot file an 01:00 expense into yesterday's (or last month's) envelope.
TZ_OFFSET_HOURS=5

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR. Below DEBUG, the chatty third-party loggers (httpx,
# httpcore, aiohttp.access, asyncio) are pinned to WARNING so the bot's own lines stay visible.
LOG_LEVEL=INFO

# --- The optional evening message (off by default) ---
# At REMINDER_HOUR, Home is sent when something needs you, plus a short weekly look on Sundays.
REMINDERS_ENABLED=false
# Local hour (0-23, in TZ_OFFSET_HOURS terms) they are delivered at.
REMINDER_HOUR=21

# --- Webhook server ---
# The bot runs in WEBHOOK mode: Telegram pushes updates to a public HTTPS URL.
#
# That URL is normally set in the web app (Developer page), stored in the backend and fetched
# at startup. Set it HERE TOO. The stored copy lives in the `settings` row, a factory reset
# TRUNCATEs that table, and the bot reads the URL before it can serve anything — so a wipe
# leaves the bot crash-looping on "No webhook URL configured", fixable only from the web app.
# This is the floor under that: the backend still wins whenever it has a value, so the
# Developer page keeps working exactly as before, and the bot can always boot without it.
# Must be HTTPS and must end in the path below.
WEBHOOK_URL=
# Same idea for the "🌐 Open app" button on Home. Optional; HTTPS only.
WEB_VIEW_URL=

# These vars control the LOCAL aiohttp server + the shared secret:
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8081
# Path the local server listens on. If the public webhook URL includes a path, that path
# is used instead (so they can't drift). Make your public URL end with this path.
WEBHOOK_PATH=/webhook
# REQUIRED IN PRODUCTION. Telegram echoes it back in X-Telegram-Bot-Api-Secret-Token and the
# server rejects mismatches. Left blank, the check is skipped entirely — aiogram's
# verify_secret returns True when there is no secret to compare — so anyone who discovers the
# public URL can POST forged updates to your bot. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
